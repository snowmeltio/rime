{
    "name": "rime",
    "displayName": "Rime",
    "description": "Auto-opens markdown preview when you open a markdown file. Clean reading view with bundled stylesheet.",
    "version": "1.2.11",
    "publisher": "snowmeltio",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/snowmeltio/rime"
    },
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.77.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "markdown",
        "preview",
        "auto-preview",
        "reading"
    ],
    "activationEvents": [
        "onLanguage:markdown",
        "onStartupFinished"
    ],
    "scripts": {
        "test": "node --require ./test/register-vscode-stub.js --test test/*.test.js",
        "screenshots": "node scripts/screenshots.mjs",
        "version": "node scripts/screenshots.mjs && git add media/screenshot-*.png"
    },
    "devDependencies": {
        "marked": "^15.0.0",
        "puppeteer": "^24.0.0"
    },
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "rime.openPreview",
                "title": "Rime: Open Markdown Preview"
            }
        ],
        "keybindings": [
            {
                "command": "rime.openPreview",
                "key": "ctrl+shift+m",
                "mac": "cmd+shift+m",
                "when": "editorLangId == markdown"
            }
        ],
        "markdown.previewStyles": [
            "./styles/preview.css"
        ],
        "configuration": {
            "title": "Rime",
            "properties": {
                "rime.focusBehaviour": {
                    "type": "string",
                    "enum": [
                        "preview",
                        "source",
                        "preserve"
                    ],
                    "enumDescriptions": [
                        "Move focus into the preview — best for pure reading.",
                        "Kept for compatibility; behaves like preview. Rime opens the preview in the source's own editor group, so returning focus to the source would hide the preview it just opened. Only refocuses the source if the preview ever lands in a different group.",
                        "Experimental: bounce focus back to an agent chat that occupies its own editor group. With the chat in the sidebar (or no chat group), focus stays in the preview."
                    ],
                    "default": "preview",
                    "markdownDescription": "Where keyboard focus lands after Rime foregrounds the markdown preview on tab activation."
                }
            }
        }
    }
}
